# Vars for docker-compose.yml (the single-container client+server+postgres
# image, see docker/allinone/). Not used by the normal dev workflow, which
# reads server/.env and client/.env instead.
#
# Copy to .env and edit before running: docker compose up -d --build
# (or ./scripts/run-allinone.ps1)

APP_PORT=8080
CLIENT_ORIGIN=http://localhost:8080

POSTGRES_PASSWORD=postgres
POSTGRES_DB=networkmanager

JWT_SECRET=change-me-to-a-long-random-string

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=0000000000
SEED_ADMIN_PASSWORD=changeme123
